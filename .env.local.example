# Variáveis do backoffice. Copie para .env.local e preencha.
#
# ⚠️ HOJE O DESENVOLVIMENTO LOCAL APONTA PARA O MESMO PROJETO SUPABASE DO
#    AMBIENTE PUBLICADO. Não existe banco separado ainda, então todo seed e toda
#    migration rodada localmente atinge os dados de lá. Ver .spec/ambientes.md
#    para criar o staging e apontar este arquivo para ele — é uma troca de três
#    variáveis, o código já suporta.
#
# Todas as variáveis marcadas OBRIGATÓRIA são validadas em src/lib/env.ts e
# derrubam o BUILD de um deploy de produção se faltarem. Isso é de propósito:
# comportamento crítico decidido por valor padrão silencioso já causou dois
# defeitos graves neste projeto.

# ── Supabase ──────────────────────────────────────────────────────────────
# OBRIGATÓRIAS em produção. URL e anon key são públicas (podem ir ao client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta — SOMENTE server-side (Netlify Functions, migrations, admin).
# Nunca commitar. Nunca expor no client.
SUPABASE_SERVICE_ROLE_KEY=

# Connection string do Postgres (Project Settings → Database → URI). NÃO é a
# mesma coisa que NEXT_PUBLIC_SUPABASE_URL. Usada só por scripts/db-migrate.mjs;
# a aplicação nunca lê esta variável.
SUPABASE_DB_URL=

# ── Pagamento ─────────────────────────────────────────────────────────────
# OBRIGATÓRIA em produção, e sem valor padrão lá: escolher entre simular e
# cobrar de verdade é uma decisão, não uma omissão. 'stub' (síncrono, sem rede)
# ou 'pagarme' (real).
PAYMENT_PROVIDER=stub

# OBRIGATÓRIO quando PAYMENT_PROVIDER=stub em ambiente publicado.
# Gere um valor seu — algo como `openssl rand -hex 24`. NÃO reutilize um valor
# de exemplo: a constante que existia no código ("stub-secret") permitia que
# qualquer pessoa assinasse um webhook e marcasse um pedido como pago.
# Vazio agora significa RECUSAR TUDO, nunca "passar porque não configurou".
STUB_PAYMENT_WEBHOOK_SECRET=

# --- Pagar.me (só quando PAYMENT_PROVIDER=pagarme) ---
# Chave SECRETA (sk_test_… em sandbox). Server-side apenas — nunca no client.
# (`PAGARME_SECRET_KEY` também é aceito, como alias.)
PAGARME_API_KEY=
# Como a cobrança no cartão é aberta:
#   auth_only        = ADOTADO (14/08). Só RESERVA o limite; a captura acontece
#                      quando a revisão clínica aprova o protocolo. Reprovar
#                      cancela a reserva — não existe estorno, o dinheiro nunca saiu.
#   auth_and_capture = cobra na hora (o pedido já nasce pago).
PAGARME_OPERATION=auth_only
# Aparece na fatura do cartão do paciente (máx. 13 caracteres).
PAGARME_STATEMENT_DESCRIPTOR=NAWA
# O webhook do Pagar.me v5 autentica por HTTP Basic — cadastre este par no painel
# deles apontando para <backoffice>/api/payments/webhook.
PAGARME_WEBHOOK_USER=
PAGARME_WEBHOOK_PASSWORD=
# Trava contra virar produção sem querer: uma chave sk_live_ só é aceita com
# esta variável em "true". Enquanto o ambiente é sandbox, deixe vazia.
PAGARME_ALLOW_LIVE=

# Rate limiting da Storefront por chave (api-boundary §3.4). Conta só cache miss
# (função storefront_rate_hit). Padrões: 120 requisições por janela de 60s.
STOREFRONT_RATE_LIMIT=120
STOREFRONT_RATE_WINDOW_SECONDS=60

# Rate limiting das rotas de ESCRITA (checkout, pagamento, cadastro), contado
# por paciente — ou por IP, quando ainda não há conta. Protege o endpoint de
# cobrança de varredura de cartão. O /checkout/v1/pay usa um limite próprio,
# mais apertado, definido no código.
WRITE_RATE_LIMIT=20
WRITE_RATE_WINDOW_SECONDS=60

# Coordenação de purge ponta a ponta (api-boundary §3.1). Ao publicar, o
# backoffice avisa o front (POST /api/revalidate) p/ invalidar o cache dele.
# URL base do front + segredo compartilhado (o MESMO no front). Vazio = no-op.
FRONT_REVALIDATE_URL=
FRONT_REVALIDATE_SECRET=

