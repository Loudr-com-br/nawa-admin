# Supabase — copie para .env.local e preencha com o seu projeto.
# URL e anon key são públicas (podem ir ao client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta — SOMENTE server-side (Netlify Functions, migrations, admin).
# Nunca commitar. Nunca expor no client.
SUPABASE_SERVICE_ROLE_KEY=

# Pagamento (spec §6.2). Provedor: 'stub' (default, síncrono, sem rede) ou
# 'pagarme' (real). Segredo do webhook do stub p/ validar a assinatura em
# /api/payments/webhook.
PAYMENT_PROVIDER=stub
STUB_PAYMENT_WEBHOOK_SECRET=stub-secret

# --- Pagar.me (só quando PAYMENT_PROVIDER=pagarme) ---
# Chave SECRETA (sk_test_… em sandbox). Server-side apenas — nunca no client.
# (`PAGARME_SECRET_KEY` também é aceito, como alias.)
PAGARME_API_KEY=
# Como a cobrança no cartão é aberta:
#   auth_and_capture (default) = cobra na hora
#   auth_only                  = só RESERVA o limite; exige capture posterior
#                                (modelo de pré-compra: capturar após a validação clínica)
PAGARME_OPERATION=auth_and_capture
# Aparece na fatura do cartão do paciente (máx. 13 caracteres).
PAGARME_STATEMENT_DESCRIPTOR=NAWA
# O webhook do Pagar.me v5 autentica por HTTP Basic — cadastre este par no painel
# deles apontando para <backoffice>/api/payments/webhook.
PAGARME_WEBHOOK_USER=
PAGARME_WEBHOOK_PASSWORD=

# Rate limiting da Storefront por chave (api-boundary §3.4). Conta só cache miss
# (função storefront_rate_hit). Padrões: 120 requisições por janela de 60s.
STOREFRONT_RATE_LIMIT=120
STOREFRONT_RATE_WINDOW_SECONDS=60

# Coordenação de purge ponta a ponta (api-boundary §3.1). Ao publicar, o
# backoffice avisa o front (POST /api/revalidate) p/ invalidar o cache dele.
# URL base do front + segredo compartilhado (o MESMO no front). Vazio = no-op.
FRONT_REVALIDATE_URL=
FRONT_REVALIDATE_SECRET=

